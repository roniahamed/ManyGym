// =====================================================================
// ENUMS
// =====================================================================

Enum user_status {
  active
  inactive
  suspended
}

Enum token_context_type {
  personal
  gym
}

Enum staff_status {
  invited
  active
  inactive
}

Enum gym_gender_required {
  everyone
  women_only
  men_only
}

Enum gym_type_enum {
  general_fitness_gym
  strength_bodybuilding_gym
  functional_fitness_gym
  personal_training_studio
  boutique_fitness_studio
  boxing_martial_arts_gym
  yoga_pilates_studio
  indoor_cycling_studio
  sports_performance_centre
  other
}

Enum gallery_category_enum {
  general
  equipment
  workout_areas
  studios_class_spaces
  changing_rooms_showers
  wellness_facilities
  reception_lounge
  interior_decor
  exterior_entrance
  other
}

Enum amenity_group_enum {
  changing_and_storage
  wellness_and_recovery
  comfort_and_convenience
  food_and_drink
  parking_and_transport
  accessibility
  family_facilities
}

Enum plan_status_enum {
  draft
  active
  archived
}

Enum plan_type_enum {
  time_based
  session_based
}

Enum duration_unit_enum {
  day
  week
  month
  session
}

Enum payment_schedule_enum {
  full_payment
  instalments
}

Enum member_joining_status {
  sent_invitation
  joined
}

Enum membership_status_enum {
  scheduled
  active
  paused
  expired
  cancelled
}

Enum payment_status_enum {
  fully_paid
  partially_paid
  unpaid
}

Enum payment_method_enum {
  cash
  credit_card
  debit_card
  bank_transfer
  mobile_pay
  other
}

Enum lead_stage_enum {
  new
  contacted
  visit_trial_booked
  joined
  not_joining
}

Enum not_joining_reason_standard {
  price
  location
  timing
  chose_another_gym
  other
}

Enum lead_source_enum {
  walk_in
  phone
  social_media
  referral
  website
  other
}

Enum fitness_goal_enum {
  general_fitness
  strength
  muscle_gain
  weight_loss
  other
}

Enum routine_format_enum {
  weekly
  session_based
}

Enum routine_level_enum {
  beginner
  intermediate
  advanced
}

Enum post_privacy_enum {
  public
  members_only
}

Enum media_type_enum {
  picture
  video
}

// =====================================================================
// 1. IDENTITY, MULTI-TENANCY & RBAC
// =====================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(50)
  status user_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table user_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null, ref: > users.id]
  avatar_url varchar(1000)
  address varchar(500)
  city varchar(100)
  country varchar(100)
  date_of_birth date
  sex varchar(20)
  nationality varchar(100)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table auth_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  gym_id uuid [ref: > gyms.id, note: 'null for personal context']
  token_hash varchar(255) [unique, not null]
  context_type token_context_type [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
}

Table gyms {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_user_id uuid [not null, ref: > users.id]
  name varchar(255) [not null]
  profile_picture_url varchar(1000)
  cover_photo_url varchar(1000)
  short_description text [note: 'min 120 chars']
  primary_type gym_type_enum [not null]
  secondary_type gym_type_enum
  gender_required gym_gender_required [not null, default: 'everyone']
  min_age int [not null, default: 1]
  timezone varchar(100) [not null, default: 'UTC']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [ref: > gyms.id, note: 'null for global system defaults: Admin, Staff, Trainer']
  name varchar(100) [not null]
  slug varchar(100) [not null]
  is_custom boolean [not null, default: false]
  description text
  created_at timestamp [not null, default: `now()`]
}

Table permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  topic varchar(100) [not null, note: 'Studio, Reports, Gym Profile, Subscription Plans, Members, Leads, Trainers, Routine Templates, People & Roles']
  scope_code varchar(100) [unique, not null, note: 'e.g. members:read, members:edit, routine:assign']
  name varchar(255) [not null]
  description text
}

Table role_permissions {
  id uuid [pk, default: `gen_random_uuid()`]
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table gym_staff_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  gym_id uuid [not null, ref: > gyms.id]
  role_id uuid [not null, ref: > roles.id]
  status staff_status [not null, default: 'active']
  invited_at timestamp [not null, default: `now()`]
  joined_at timestamp

  indexes {
    (user_id, gym_id, role_id) [unique]
  }
}

// =====================================================================
// 2. GYM PROFILE: LOCATION, HOURS, GALLERY & AMENITIES
// =====================================================================

Table gym_locations {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  address text [not null]
  latitude decimal(10, 8) [not null]
  longitude decimal(11, 8) [not null]
  city varchar(100)
  country varchar(100)
  postal_code varchar(30)
  is_primary boolean [not null, default: true]
  updated_at timestamp [not null, default: `now()`]
}

Table gym_opening_hours {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  day_of_week int [not null, note: '0=Sunday, 1=Monday ... 6=Saturday']
  start_time time
  end_time time
  is_closed boolean [not null, default: false]

  indexes {
    (gym_id, day_of_week) [unique]
  }
}

Table gym_gallery {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  media_url varchar(1000) [not null]
  media_type media_type_enum [not null, default: 'picture']
  category gallery_category_enum [not null, default: 'general']
  caption varchar(200)
  order_index int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table amenity_catalog {
  id uuid [pk, default: `gen_random_uuid()`]
  group_name amenity_group_enum [not null]
  name varchar(150) [not null]

  indexes {
    (group_name, name) [unique]
  }
}

Table gym_amenities {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  amenity_id uuid [not null, ref: > amenity_catalog.id]
  is_paid boolean [not null, default: false, note: 'true=Paid Amenity, false=Free Amenity']
  default_price decimal(10, 2) [default: 0.00]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (gym_id, amenity_id) [unique]
  }
}

// =====================================================================
// 3. MEMBERSHIP PLANS
// =====================================================================

Table membership_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  name varchar(255) [not null]
  description text [note: 'min 50 chars']
  plan_status plan_status_enum [not null, default: 'draft']
  plan_type plan_type_enum [not null]
  price decimal(10, 2) [not null]
  duration_value int [not null, note: 'e.g. 3 for 3 months or 10 for 10 sessions']
  duration_unit duration_unit_enum [not null]
  joining_fee decimal(10, 2) [not null, default: 0.00]
  payment_schedule payment_schedule_enum [not null, default: 'full_payment']
  installment_schedule_config jsonb [note: 'details if payment_schedule is instalments']
  cancellation_policy text
  refund_policy text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table plan_included_amenities {
  id uuid [pk, default: `gen_random_uuid()`]
  plan_id uuid [not null, ref: > membership_plans.id]
  gym_amenity_id uuid [not null, ref: > gym_amenities.id]

  indexes {
    (plan_id, gym_amenity_id) [unique]
  }
}

// =====================================================================
// 4. MEMBERS & SUBSCRIPTIONS
// =====================================================================

Table members {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  user_id uuid [ref: > users.id, note: 'optional until member accepts invite']
  assigned_trainer_id uuid [ref: > gym_staff_assignments.id]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null]
  phone varchar(50)
  profile_photo_url varchar(1000)
  address varchar(500)
  city varchar(100)
  country varchar(100)
  date_of_birth date
  sex varchar(20)
  nationality varchar(100)
  emergency_contact_name varchar(150)
  emergency_contact_phone varchar(50)
  emergency_contact_relationship varchar(100)
  joining_status member_joining_status [not null, default: 'sent_invitation']
  internal_notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table member_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  member_id uuid [not null, ref: > members.id]
  plan_id uuid [not null, ref: > membership_plans.id]
  membership_status membership_status_enum [not null, default: 'active']
  payment_status payment_status_enum [not null, default: 'unpaid']
  start_date date [not null]
  end_date date [not null]
  total_sessions int [default: null, note: 'copied from plan for session-based']
  remaining_sessions int [default: null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table member_extra_amenities {
  id uuid [pk, default: `gen_random_uuid()`]
  member_subscription_id uuid [not null, ref: > member_subscriptions.id]
  gym_amenity_id uuid [not null, ref: > gym_amenities.id]
  extra_fee decimal(10, 2) [not null, default: 0.00]
  is_active boolean [not null, default: true]

  indexes {
    (member_subscription_id, gym_amenity_id) [unique]
  }
}

Table member_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  member_subscription_id uuid [not null, ref: > member_subscriptions.id]
  amount decimal(10, 2) [not null]
  payment_method payment_method_enum [not null]
  payment_date date [not null]
  is_initial_payment boolean [not null, default: false]
  notes text
  created_at timestamp [not null, default: `now()`]
}

// =====================================================================
// 5. LEADS / CRM
// =====================================================================

Table lead_custom_reasons {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  reason_name varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (gym_id, reason_name) [unique]
  }
}

Table leads {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  interested_plan_id uuid [ref: > membership_plans.id]
  assigned_staff_id uuid [ref: > gym_staff_assignments.id]
  converted_member_id uuid [ref: > members.id]
  first_name varchar(100) [not null]
  last_name varchar(100)
  phone varchar(50)
  email varchar(255)
  stage lead_stage_enum [not null, default: 'new']
  not_joining_reason_standard not_joining_reason_standard
  not_joining_custom_reason_id uuid [ref: > lead_custom_reasons.id]
  expected_start_date date
  source lead_source_enum [not null, default: 'walk_in']
  trial_booked_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table lead_fitness_goals {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [not null, ref: > leads.id]
  goal fitness_goal_enum [not null]

  indexes {
    (lead_id, goal) [unique]
  }
}

Table lead_next_moves {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [not null, ref: > leads.id]
  scheduled_date date [not null]
  short_description varchar(255) [not null]
  is_completed boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}

Table lead_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [not null, ref: > leads.id]
  author_staff_id uuid [ref: > gym_staff_assignments.id]
  note_text text [not null]
  created_at timestamp [not null, default: `now()`]
}

// =====================================================================
// 6. ROUTINE TEMPLATES & MEMBER WORKOUTS
// =====================================================================

Table routine_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  created_by_staff_id uuid [ref: > gym_staff_assignments.id]
  template_name varchar(255) [not null]
  routine_format routine_format_enum [not null]
  level routine_level_enum [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table routine_template_goals {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null, ref: > routine_templates.id]
  goal fitness_goal_enum [not null]

  indexes {
    (template_id, goal) [unique]
  }
}

Table routine_template_days {
  id uuid [pk, default: `gen_random_uuid()`]
  template_id uuid [not null, ref: > routine_templates.id]
  day_of_week int [note: '1=Monday...7=Sunday for weekly']
  session_number int [note: '1, 2, 3... for session-based']
  is_rest_day boolean [not null, default: false]
  workout_title varchar(255)
  workday_note text
  sort_order int [not null, default: 0]
}

Table routine_template_exercises {
  id uuid [pk, default: `gen_random_uuid()`]
  template_day_id uuid [not null, ref: > routine_template_days.id]
  exercise_name varchar(255) [not null]
  sets int [note: 'nullable for cardio']
  reps_or_duration varchar(100) [not null, note: 'e.g. 10 reps or 15 min']
  rest_seconds int
  notes text
  sort_order int [not null, default: 0]
}

Table member_routines {
  id uuid [pk, default: `gen_random_uuid()`]
  member_id uuid [not null, ref: > members.id]
  source_template_id uuid [ref: > routine_templates.id]
  prescribed_by_staff_id uuid [ref: > gym_staff_assignments.id]
  routine_name varchar(255) [not null]
  routine_format routine_format_enum [not null]
  level routine_level_enum [not null]
  is_active boolean [not null, default: true]
  assigned_at timestamp [not null, default: `now()`]
}

Table member_routine_days {
  id uuid [pk, default: `gen_random_uuid()`]
  member_routine_id uuid [not null, ref: > member_routines.id]
  day_of_week int
  session_number int
  is_rest_day boolean [not null, default: false]
  workout_title varchar(255)
  workday_note text
  sort_order int [not null, default: 0]
}

Table member_routine_exercises {
  id uuid [pk, default: `gen_random_uuid()`]
  member_routine_day_id uuid [not null, ref: > member_routine_days.id]
  exercise_name varchar(255) [not null]
  sets int
  reps_or_duration varchar(100) [not null]
  rest_seconds int
  notes text
  sort_order int [not null, default: 0]
}

// =====================================================================
// 7. SOCIAL POSTS & MEDIA
// =====================================================================

Table gym_posts {
  id uuid [pk, default: `gen_random_uuid()`]
  gym_id uuid [not null, ref: > gyms.id]
  author_user_id uuid [not null, ref: > users.id]
  content_text text [note: 'optional if media exists']
  privacy post_privacy_enum [not null, default: 'public']
  published_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table gym_post_media {
  id uuid [pk, default: `gen_random_uuid()`]
  post_id uuid [not null, ref: > gym_posts.id]
  media_url varchar(1000) [not null]
  media_type media_type_enum [not null]
  thumbnail_url varchar(1000) [note: 'generated for video, editable']
  file_size_bytes bigint [not null, note: '<=10MB image, <=200MB video']
  order_index int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

// =====================================================================
// TABLE GROUPS
// =====================================================================

TableGroup Auth_and_Tenancy {
  users
  user_profiles
  auth_tokens
  gyms
  roles
  permissions
  role_permissions
  gym_staff_assignments
}

TableGroup Gym_Profile_Details {
  gym_locations
  gym_opening_hours
  gym_gallery
  amenity_catalog
  gym_amenities
}

TableGroup Plans_and_Members {
  membership_plans
  plan_included_amenities
  members
  member_subscriptions
  member_extra_amenities
  member_payments
}

TableGroup Leads_CRM {
  lead_custom_reasons
  leads
  lead_fitness_goals
  lead_next_moves
  lead_notes
}

TableGroup Routine_and_Workouts {
  routine_templates
  routine_template_goals
  routine_template_days
  routine_template_exercises
  member_routines
  member_routine_days
  member_routine_exercises
}

TableGroup Posts_and_Feed {
  gym_posts
  gym_post_media
}

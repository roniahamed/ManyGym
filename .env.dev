# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-dev-key-manygym-super-secret-random-token-2026!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=manygym_db
DB_USER=manygym_user
DB_PASSWORD=manygym_dev_pass_123
DB_HOST=db
DB_PORT=5432

# Docker PostgreSQL Container Env
POSTGRES_DB=manygym_db
POSTGRES_USER=manygym_user
POSTGRES_PASSWORD=manygym_dev_pass_123
POSTGRES_PORT=5435

# Redis & Caching Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_PORT_HOST=6385

# Celery Broker & Backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Media and Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/static_collected
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# Ports for Host Mapping
WEB_PORT=5000
NGINX_PORT=8090

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@manygym.com


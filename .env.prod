# Django Production Configuration
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_ENV_VAULT_REQUIRED
DEBUG=False
ALLOWED_HOSTS=api.manygym.com,manygym.com

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.manygym.com,https://manygym.com

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=manygym_prod_db
DB_USER=manygym_prod_user
DB_PASSWORD=REPLACE_WITH_SECURE_PROD_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# Docker PostgreSQL Container Env
POSTGRES_DB=manygym_prod_db
POSTGRES_USER=manygym_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PROD_DB_PASSWORD
POSTGRES_PORT=5432

# Redis & Caching Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=1

# Celery Broker & Backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Media and Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/static_collected
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# Ports for Host Mapping
WEB_PORT=8000
NGINX_PORT=80

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_SENDGRID_KEY
DEFAULT_FROM_EMAIL=noreply@manygym.com
